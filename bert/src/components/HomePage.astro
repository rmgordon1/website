---
/**
 * Layered, media-driven landing page. Stacking, front → back:
 *   1. hover hotspots (invisible, catch pointer over each screen)
 *   2. cockpit transparent video (.bg-media)
 *   3. planet background image (.bg-media--back)
 *   4. screen videos (.screen-video) — hidden behind everything at rest,
 *      brought to the front while their hotspot is hovered.
 *
 * The two "reverse" screen videos share the cockpit's 1920×1080 canvas, so
 * rendered full-screen with object-fit:cover their visible squares land
 * exactly on the left ("Portfolio") and right ("Pokémon Showdown") screens.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TransparentVideo from './TransparentVideo.astro';
import { mediaUrl } from '../config/site';

// Each clip has a WebM (Chrome/Firefox) and HEVC mp4 (Safari/iOS) on CloudFront.
// TransparentVideo picks the right URL from the User-Agent.
const underwaterWebm = mediaUrl('/homepage/underwater.webm');
const underwaterHevc = mediaUrl('/homepage/underwater.mp4');
const bgWebm = mediaUrl('/homepage/sub.webm');
const bgHevc = mediaUrl('/homepage/sub.mp4');
const portfolioWebm = mediaUrl('/homepage/final_portfolio_reverse.webm');
const portfolioHevc = mediaUrl('/homepage/final_portfolio_reverse.mp4');
const showdownWebm = mediaUrl('/homepage/final_showdown_reverse.webm');
const showdownHevc = mediaUrl('/homepage/final_showdown_reverse.mp4');
---

<BaseLayout title="Bert">
  {/* 16:9 stage: shrinks to the visible viewport (100svh) so mobile URL chrome
      cannot cover the scene. All media + hotspots live inside this frame so
      they stay aligned as the box letterboxes. */}
  <div class="stage">
  <div class="stage__frame">

  {/* Hotspots come first in the DOM so the CSS `~` sibling selector can link
      each hovered hotspot to its screen video. Paint order is controlled by
      z-index, not DOM order, so these still render on top. */}
  <div class="screen-hotspot screen-hotspot--portfolio" aria-hidden="true"></div>
  <div class="screen-hotspot screen-hotspot--showdown" aria-hidden="true"></div>

  {/* Deepest layer: screen videos, hidden behind everything until hovered.
      Wrapper divs keep the hover sibling selector in this file (TransparentVideo
      renders a custom element, which would otherwise break `~ .screen-video`). */}
  <div class="screen-video screen-video--portfolio" aria-hidden="true">
    <TransparentVideo webmSrc={portfolioWebm} hevcSrc={portfolioHevc} alt="" />
  </div>
  <div class="screen-video screen-video--showdown" aria-hidden="true">
    <TransparentVideo webmSrc={showdownWebm} hevcSrc={showdownHevc} alt="" />
  </div>

  {/* Back layer: full-screen background video (§3 Media-Driven UI) */}
  <TransparentVideo
    class="bg-media bg-media--back"
    webmSrc={underwaterWebm}
    hevcSrc={underwaterHevc}
    alt="Underwater background"
  />

  {/* Front layer: transparent cockpit video (§4.1) */}
  <TransparentVideo
    class="bg-media"
    webmSrc={bgWebm}
    hevcSrc={bgHevc}
    alt="Sci-fi cockpit control panel"
  />

  <main class="home">
    <nav class="home__nav" aria-label="Primary">
      <a class="home__link" href="/projects">Projects</a>
    </nav>
  </main>

  </div>
  </div>
</BaseLayout>

<style>
  /* ---- 16:9 stage ---------------------------------------------------- *
   * The scene is authored at 1920×1080. Instead of stretching it to cover
   * the viewport (which crops, and on mobile sits under the URL bar), the
   * outer `.stage` is the *visible* viewport (`100svh` = screen minus chrome)
   * and `.stage__frame` is the largest 16:9 box that fits inside it —
   * same idea as object-fit: contain. Black letterbox around the frame. */
  .stage {
    position: fixed;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    height: 100svh;
    background: #000;
  }

  .stage__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: min(100%, calc(100svh * 16 / 9));
    overflow: hidden;
  }

  /* Videos are position:fixed in global.css so they fill the viewport.
   * Inside the frame they must fill *the frame*, not the screen. */
  .stage__frame :global(.bg-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---- Hover-reveal screen videos ------------------------------------- *
   * Sized to the 16:9 frame (not the viewport) so their visible squares land
   * on the matching cockpit screens. Hidden behind everything (z-index:-3,
   * opacity:0) at rest; a hovered hotspot brings the matching one forward. */
  .screen-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -3;
    opacity: 0;
    pointer-events: none; /* hover is driven by the hotspots, not the video */
    /* Fade opacity; delay dropping z-index on leave so the fade-out stays
       visible in front before the clip returns behind everything. */
    transition:
      opacity 0.28s ease,
      z-index 0s linear 0.28s;
  }

  .screen-hotspot--portfolio:hover ~ .screen-video--portfolio,
  .screen-hotspot--showdown:hover ~ .screen-video--showdown {
    opacity: 1;
    z-index: 20; /* above the cockpit video + image, below the hotspots */
    transition:
      opacity 0.28s ease,
      z-index 0s; /* jump to front immediately on hover */
  }

  .screen-video :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---- Hover hotspots over each cockpit screen ------------------------ *
   * Invisible pointer targets sized to the visible square. Positions are in
   * % of the viewport, tuned for a ~16:9 display; adjust the custom props if
   * your screen crops differently. */
  .screen-hotspot {
    position: absolute;
    z-index: 30; /* on top, so it always catches the hover */
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    /* background: rgba(255, 0, 255, 0.3); */ /* uncomment to visualize */
  }

  .screen-hotspot--portfolio {
    --x: 24.5%;
    --y: 21%;
    --w: 12.5%;
    --h: 19%;
  }

  .screen-hotspot--showdown {
    --x: 63%;
    --y: 21%;
    --w: 12.5%;
    --h: 19%;
  }

  /* ---- Foreground content --------------------------------------------- */
  .home {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 3rem;
  }

  .home__nav {
    display: flex;
    gap: 2rem;
  }

  .home__link {
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .home__link:hover,
  .home__link:focus-visible {
    border-color: currentColor;
  }
</style>
